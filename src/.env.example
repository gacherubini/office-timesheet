PORT=3333

# Postgres (local: docker-compose; prod: Fly internal DNS)
DATABASE_URL=postgres://postgres:dev@localhost:5432/office_timesheet

# Auth
JWT_SECRET=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# URLs / CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173

# Storage (Tigris/S3) — vazio = upload desabilitado
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=auto
BUCKET_NAME=

# Email (Resend) — vazio = link de reset aparece no console em dev
RESEND_API_KEY=

# Cifra das URLs secretas de agenda iCal (qualquer string; vazio = recurso de
# calendário desabilitado). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALENDAR_ENC_KEY=

# Agenda do escritório (compartilhada, todos os usuários logados veem).
# Cole o "endereço secreto no formato iCal" da agenda projetos@studiovivian.com.br.
# Vazio = sem agenda do escritório.
OFFICE_ICS_URL=

# Observabilidade
# LOG_LEVEL: debug | info | warn | error. Default: info em prod, debug fora.
LOG_LEVEL=

# Axiom (log center). Vazio = logs só no stdout / `fly logs`.
# Crie um dataset e um API token em https://app.axiom.co
AXIOM_TOKEN=
AXIOM_DATASET=

# ─── Agente (assistente conversacional) ─────────────────────────────────────
# Kill switch. Ausente ou 'true' = ligado; qualquer outro valor derruba /agent/*
# com 503, sem precisar de deploy.
AGENT_ENABLED=true

# Provedor OpenAI-compatible + modelo. Default do código: DeepSeek V4 Flash na
# API oficial da DeepSeek (https://api.deepseek.com). Sem AGENT_API_KEY a rota
# responde 503.
AGENT_PROVIDER_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-v4-flash
AGENT_API_KEY=

# Preço do modelo em USD por 1M de tokens — alimenta o campo `custo` da linha de
# log agent_usage, que é a base dos alertas de gasto no Axiom. Sem estes valores
# o custo sai `null` (e não zero, que mentiria). Números de referência da tabela
# do DeepSeek V4 Flash; reconcilie com a fatura real.
AGENT_PRICE_IN=0.14
AGENT_PRICE_OUT=0.28
AGENT_PRICE_CACHED=0.14

# SQL ad-hoc (tool consultar_dados, admin-only): role somente-leitura dedicada,
# criada pelas migrations 030/031. Sem isto a tool falha só para o admin.
AGENT_READONLY_DATABASE_URL=

# Temperatura. Sem isto o provedor assume a dele (1.0), que é solta demais para
# escolher ferramenta. 0.7 é escolha de produto, não medição — prioriza texto
# natural, aceitando alguma variação na escolha de tool porque toda escrita passa
# por confirmação. Se a mesma pergunta começar a cair em tools diferentes, baixe
# para 0.3–0.4. O código respeita o 0 explícito (determinístico).
AGENT_TEMPERATURE=0.7

# Guardas por requisição — os valores abaixo são os defaults do código.
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOKENS=2048
# Pintura token-a-token. Default off: o primeiro delta pode não delatar.
AGENT_STREAM_PAINT=false
AGENT_TIMEOUT_MS=30000
AGENT_MAX_CONCURRENT_PER_USER=1
# Teto por janela de 15 min, por usuário (criado na Task 4 deste plano).
AGENT_CHAT_RATE_MAX=40
# Corte do resultado de tool antes de entrar no histórico (Task 5 deste plano).
AGENT_MAX_TOOL_RESULT_CHARS=20000

# Retry da chamada ao modelo. AGENT_MAX_RETRIES=0 desliga o retry (o código
# respeita o 0 explícito, não cai no default — ver envInt em client.js).
AGENT_MAX_RETRIES=2
AGENT_RETRY_BACKOFF_MS=250
AGENT_ATTEMPT_TIMEOUT_MS=30000

# Pool da conexão somente-leitura do SQL ad-hoc.
AGENT_SQL_MAX_ROWS=200
AGENT_SQL_TIMEOUT_MS=3000
AGENT_SQL_POOL_MAX=4
